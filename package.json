{
  "name": "scopecraft",
  "version": "0.2.0",
  "description": "An educational patent-claim drafting game with examination, amendment, and design-around challenges.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacoba1100254352/patentpractice.jacobdanderson.net.git"
  },
  "homepage": "https://github.com/Jacoba1100254352/patentpractice.jacobdanderson.net#readme",
  "bugs": {
    "url": "https://github.com/Jacoba1100254352/patentpractice.jacobdanderson.net/issues"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.18.1",
    "npm": "12.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": false
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:download-approval && npm run compatibility:check && npm run challenges:check && node scripts/clean-build.mjs && vite build && node scripts/prepare-static-build.mjs && node scripts/verify-client-artifact.mjs",
    "build:sites": "npm run build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=high",
    "verify:download-approval": "node scripts/verify-download-approval.mjs",
    "compatibility:generate": "node scripts/build-engine-compatibility.mjs",
    "compatibility:check": "node scripts/build-engine-compatibility.mjs --check",
    "challenges:generate": "node scripts/build-reviewed-challenges.mjs",
    "challenges:check": "node scripts/build-reviewed-challenges.mjs --check",
    "check": "npm run compatibility:check && npm run challenges:check && npm run test && npm run test:artifact && npm run test:standalone && npm run test:sites",
    "test:artifact": "node --test tests/archive-security.test.mjs tests/client-artifact.test.mjs tests/download-approval.test.mjs",
    "test:standalone": "node --test tests/standalone-build.test.mjs",
    "test:sites": "npm run build:sites && node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "idb": "^8.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "pdfjs-dist": "6.3.289",
    "vite": "6.4.3",
    "vitest": "^4.1.11",
    "yauzl": "3.4.0"
  }
}
