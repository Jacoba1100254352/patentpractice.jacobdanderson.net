server {
    listen 80;
    listen [::]:80;
    server_name patentpractice.example.com;

    root /srv/scopecraft/dist/client;
    index index.html;

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /downloads/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    location / {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        try_files $uri $uri/ @scopecraft_app;
        add_header Cache-Control "no-cache";
    }

    location @scopecraft_app {
        if ($http_accept !~* "text/html") {
            return 404;
        }
        rewrite ^ /index.html last;
    }
}
